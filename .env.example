# Copy to .env and fill in locally. Never commit real values.
FOOTFALL_DB=footfall.sqlite3
FLASK_SECRET_KEY=change-me
FOOTFALL_LLM=none            # azure | ollama | anthropic | none
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ollama: a model running locally. Free, no API key, no billing. Needs `ollama serve`.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_TIMEOUT_S=180

# A local model is slower than a hosted one; raise the refresh budget so all sources are reached.
FOOTFALL_REFRESH_MAX_SECONDS=90

# For the configured reasoning-model deployment; never copy real keys into this file.
AZURE_OPENAI_REASONING_EFFORT=none
AZURE_OPENAI_MAX_COMPLETION_TOKENS=2048

# Optional remote SQLite for shared/serverless hosting (both values required).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Shared demo lifetime call allowance, not a monetary billing cutoff.
FOOTFALL_AZURE_CALL_LIMIT=20
